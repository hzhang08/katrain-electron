{
  "name": "katrain-electron",
  "productName": "KaTrain Electron",
  "version": "1.0.0",
  "description": "Original KaTrain desktop experience hosted in Electron",
  "license": "MIT",
  "private": true,
  "main": "app/main.cjs",
  "scripts": {
